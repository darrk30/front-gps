# API REST de Laravel
VITE_API_URL=http://localhost:8000/api

# Google OAuth (login institucional)
VITE_GOOGLE_CLIENT_ID=

# Laravel Reverb (WebSocket / tiempo real)
VITE_REVERB_APP_KEY=
VITE_REVERB_HOST=localhost
VITE_REVERB_PORT=8080
VITE_REVERB_SCHEME=http

# Firebase Web (push notifications) — Firebase Console del proyecto
# api-gps-1ce9b -> Configuración del proyecto -> Tus apps -> app Web.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
# Cloud Messaging -> Configuración web -> Generar par de claves.
VITE_FIREBASE_VAPID_KEY=
