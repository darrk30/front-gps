# Copiá este archivo como .env (valores compartidos por todos los entornos),
# .env.development (para `npm run dev`) y .env.production (para
# `npm run build`) — Vite carga automáticamente el que corresponde según el
# modo y lo combina con .env. Ver README/las notas de cada uno para el
# detalle de qué va en cuál.

# API REST de Laravel — cambia según entorno (.env.development / .env.production)
VITE_API_URL=http://localhost:8000/api

# Google OAuth (login institucional) — compartido
VITE_GOOGLE_CLIENT_ID=

# Laravel Reverb (WebSocket / tiempo real)
VITE_REVERB_APP_KEY=
# El host/puerto/esquema cambian según entorno (.env.development / .env.production)
VITE_REVERB_HOST=localhost
VITE_REVERB_PORT=8080
VITE_REVERB_SCHEME=http

# Firebase Web (push notifications) — Firebase Console del proyecto
# api-gps-1ce9b -> Configuración del proyecto -> Tus apps -> app Web. Compartido.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
# Cloud Messaging -> Configuración web -> Generar par de claves.
VITE_FIREBASE_VAPID_KEY=
